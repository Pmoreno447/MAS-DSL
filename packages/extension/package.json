{
    "name": "vscode-multiAgentDSL",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "multiAgentDSL",
    "publisher": "pmoreno",
    "type": "module",
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "multi-agent-dsl",
            "aliases": ["multiAgentDSL", "multi-agent-dsl"],
            "extensions": [".mad"],
            "configuration": "./language-configuration.json",
            "icon": {
                "light": "./icons/mad.svg",
                "dark": "./icons/mad.svg"
            }
        }],
        "grammars": [{
            "language": "multi-agent-dsl",
            "scopeName": "source.multi-agent-dsl",
            "path": "syntaxes/multi-agent-dsl.tmLanguage.json"
        }],
        "snippets": [{
            "language": "multi-agent-dsl",
            "path": "./snippets/multi-agent-dsl.code-snippets"
        }],
        "configurationDefaults": {
            "[multi-agent-dsl]": {
                "editor.wordBasedSuggestions": "off"
            }
        },
        "commands": [
            {
                "command": "multi-agent-dsl.generate",
                "title": "Generar código LangGraph",
                "category": "multiAgentDSL",
                "icon": "$(rocket)"
            },
            {
                "command": "multi-agent-dsl.preview",
                "title": "Ver diagrama del modelo",
                "category": "multiAgentDSL",
                "icon": "$(graph)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "multi-agent-dsl.preview",
                    "when": "resourceExtname == .mad",
                    "group": "navigation"
                },
                {
                    "command": "multi-agent-dsl.generate",
                    "when": "resourceExtname == .mad",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "multi-agent-dsl.generate",
                    "when": "resourceExtname == .mad"
                },
                {
                    "command": "multi-agent-dsl.preview",
                    "when": "resourceExtname == .mad"
                }
            ]
        }
    },
    "extensionDependencies": [
        "bierner.markdown-mermaid"
    ],
    "activationEvents": [
        "onLanguage:multi-agent-dsl",
        "onCommand:multi-agent-dsl.generate",
        "onCommand:multi-agent-dsl.preview"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/multi-agent-dsl.tmLanguage.json ./syntaxes/multi-agent-dsl.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "multi-agent-dsl-language": "0.0.1",
        "multi-agent-dsl-cli": "0.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.67.0",
        "concurrently": "~8.2.1",
        "esbuild": "~0.25.5"
    },
    "vsce": {
      "dependencies": false
    }
}
