{
    "MAD Template": {
        "prefix": "template",
        "description": "Plantilla base de un sistema multi-agente",
        "body": [
            "{",
            "\tcontext ${1:Template} {",
            "\t\tattribute info type string description \"example of information exchange between agents\"",
            "\t\tattribute result type boolean description \"example of attribute\"",
            "",
            "\t\t//maxMessages 3",
            "\t\tpersistence inMemorySave // MongoDB | Postgre",
            "\t}",
            "",
            "\tprofile profile1 description",
            "\t\"",
            "PROMPT 1",
            "\t\"",
            "",
            "\tprofile profile2 description",
            "\t\"",
            "PROMPT 2",
            "\t\"",
            "",
            "\t// Tools:",
            "\t/*",
            "\tpythonTool exampleTool modulePath \"utils\"",
            "\tmcpServer Tavily {",
            "\t\turl \"https://mcp.tavily.com/mcp/\"",
            "\t\ttransport \"streamable_http\"",
            "\t\tapiKeyName \"TAVILY_API_KEY\"",
            "\t\ttools \"tavily_search\", \"tavily_extract\"",
            "\t}",
            "\t*/",
            "",
            "\t// agent, coordinator or summarizer",
            "\tagent Agente1 {",
            "\t\tprovider openai",
            "\t\tmodel \"gpt-4o\"",
            "\t\tprofile profile1",
            "\t\ttemperature 0.0",
            "",
            "\t\tstateUpdate info",
            "\t}",
            "",
            "\tagent Agente2 {",
            "\t\tprovider openai",
            "\t\tmodel \"gpt-4o\"",
            "\t\tprofile profile2",
            "",
            "\t\t//description \"This is an ai agent\"",
            "\t\tstateContext info",
            "\t\tstateUpdate result",
            "",
            "\t\t//statusMessage \"Im working in the result\"",
            "\t\t//maxToken 3000",
            "\t\t//timeOut 100",
            "\t\t//maxRetries 2",
            "\t\t//tools",
            "\t}",
            "",
            "\t// Layered, shared_message_pool, centralized or decentralized",
            "\tlayered ${2:structura1} {",
            "\t\tlayer Agente1 next Agente2",
            "\t\tlayer Agente2",
            "\t}",
            "",
            "\tfrom START to ${2:structura1}",
            "\t//from ${2:structura1} to structura2 when result equal False",
            "\tfrom ${2:structura1} to END",
            "}",
            "$0"
        ]
    }
}
