{
    "MAD Template": {
        "prefix": "template",
        "description": "Plantilla base de un sistema multi-agente",
        "body": [
            "{",
            "\tcontext ${1:Template} {",
            "\t\tattribute info type string description \"example of information exchange between agents\"",
            "\t\tattribute result type boolean description \"example of attribute\"",
            "",
            "\t\t//maxMessages 3",
            "\t\tpersistence inMemorySave // MongoDB | Postgre",
            "\t}",
            "",
            "\tprofile profile1 description",
            "\t\"",
            "PROMPT 1",
            "\t\"",
            "",
            "\tprofile profile2 description",
            "\t\"",
            "PROMPT 2",
            "\t\"",
            "",
            "\t// Tools:",
            "\t/*",
            "\tpythonTool exampleTool modulePath \"utils\"",
            "\tmcpServer Tavily {",
            "\t\turl \"https://mcp.tavily.com/mcp/\"",
            "\t\ttransport \"streamable_http\"",
            "\t\tapiKeyName \"TAVILY_API_KEY\"",
            "\t\ttools \"tavily_search\", \"tavily_extract\"",
            "\t}",
            "\t*/",
            "",
            "\t// agent, coordinator or summarizer",
            "\tagent Agente1 {",
            "\t\tprovider openai",
            "\t\tmodel \"gpt-4o\"",
            "\t\tprofile profile1",
            "\t\ttemperature 0.0",
            "",
            "\t\tstateUpdate info",
            "\t}",
            "",
            "\tagent Agente2 {",
            "\t\tprovider openai",
            "\t\tmodel \"gpt-4o\"",
            "\t\tprofile profile2",
            "",
            "\t\t//description \"This is an ai agent\"",
            "\t\tstateContext info",
            "\t\tstateUpdate result",
            "",
            "\t\t//statusMessage \"Im working in the result\"",
            "\t\t//maxToken 3000",
            "\t\t//timeOut 100",
            "\t\t//maxRetries 2",
            "\t\t//tools",
            "\t}",
            "",
            "\t// Layered, shared_message_pool, centralized or decentralized",
            "\tlayered ${2:structura1} {",
            "\t\tlayer Agente1 next Agente2",
            "\t\tlayer Agente2",
            "\t}",
            "",
            "\tfrom START to ${2:structura1}",
            "\t//from ${2:structura1} to structura2 when result equal False",
            "\tfrom ${2:structura1} to END",
            "}",
            "$0"
        ]
    },
    "Agent": {
        "prefix": "agent",
        "description": "Declaración de un agente",
        "body": [
            "agent ${1:NombreAgente} {",
            "\tprovider ${2|openai,anthropic,ollama,google_genai|}",
            "\tmodel \"${3:gpt-4o}\"",
            "\tprofile ${4:profile1}",
            "\ttemperature ${5:0.0}",
            "",
            "\tstateContext ${6:info}",
            "\tstateUpdate ${7:result}",
            "}",
            "$0"
        ]
    },
    "MCP Server": {
        "prefix": "mcpServer",
        "description": "MCP Server genérico",
        "body": [
            "mcpServer ${1:NombreServidor} {",
            "\turl \"${2:https://mcp.example.com/mcp/}\"",
            "\ttransport \"${3:streamable_http}\"",
            "\tapiKeyName \"${4:API_KEY}\"",
            "\ttools \"${5:tool_name}\"",
            "}",
            "$0"
        ]
    },
    "MCP Tavily": {
        "prefix": "mcpServer",
        "description": "Herramienta de búsqueda y extracción web (Tavily)",
        "body": [
            "mcpServer Tavily {",
            "\turl \"https://mcp.tavily.com/mcp/?tavilyApiKey={key}\"",
            "\ttransport \"streamable_http\"",
            "\tapiKeyName \"TAVILY_API_KEY\"",
            "\ttools \"tavily_search\", \"tavily_extract\"",
            "}",
            "$0"
        ]
    },
    "Transition": {
        "prefix": "transition",
        "description": "Transición entre estructuras de comunicación",
        "body": [
            "from ${1:origen} to ${2:destino} when ${3:atributo} ${4|equal,greather,lower|} ${5:True}",
            "$0"
        ]
    },
    "Layered Structure": {
        "prefix": "layered",
        "description": "Estructura de comunicación por capas",
        "body": [
            "layered ${1:NombreEstructura} {",
            "\tlayer ${2:Agente1} next ${3:Agente2}",
            "\tlayer ${3:Agente2}",
            "}",
            "$0"
        ]
    },
    "Centralized Structure": {
        "prefix": "centralized",
        "description": "Estructura de comunicación centralizada",
        "body": [
            "centralized ${1:NombreEstructura} {",
            "\tcoordinator ${2:Coordinador}",
            "\tagents ${3:Agente1}, ${4:Agente2}",
            "}",
            "$0"
        ]
    },
    "Decentralized Structure": {
        "prefix": "decentralized",
        "description": "Estructura de comunicación descentralizada",
        "body": [
            "decentralized ${1:NombreEstructura} {",
            "\tagents ${2:Agente1}, ${3:Agente2}",
            "}",
            "$0"
        ]
    }
}
