exports[`Generator snapshots > MD11 > agents.py 1`] = `
"# agents.py
from langchain_core.messages import SystemMessage, HumanMessage, AIMessage, ToolMessage
from prompt import PROFILE1, PROFILE2, PROFILE3
from state import State
from langchain.chat_models import init_chat_model


from config import OLLAMA_BASE_URL

from tools.mcpClients import tavily_search, tavily_extract


# Salidas de los nodos


# Modelos
modelAgente1 = init_chat_model(model="ollama:qwen2.5:7b", temperature=0, base_url=OLLAMA_BASE_URL).bind_tools([tavily_search, tavily_extract])
modelAgente2 = init_chat_model(model="ollama:qwen2.5:7b", temperature=0, base_url=OLLAMA_BASE_URL)

_tools_by_name = {t.name: t for t in [tavily_search, tavily_extract]}

def _system_prompt(profile: str, state) -> str:
    """Antepone el resumen acumulado de la conversación (si existe) al profile."""
    resumen = state.get("summary")
    if resumen:
        return f"{profile}\\n\\nContexto previo resumido:\\n{resumen}"
    return profile

# Nodos del grafo
async def nodeAgente1(state: State):
    """"""
    messages = (
        [SystemMessage(content=_system_prompt(PROFILE2, state))]
        + state["messages"]
        
    )
    while True:
        response = await modelAgente1.ainvoke(messages)
        messages.append(response)
        if not response.tool_calls:
            response.name = "agente1"
            return {"messages": [response]}
        for tc in response.tool_calls:
            tool = _tools_by_name[tc["name"]]
            try:
                result = await tool.ainvoke(tc["args"])
                messages.append(ToolMessage(content=str(result), tool_call_id=tc["id"]))
            except Exception as e:
                messages.append(ToolMessage(content=f"Error al llamar herramienta '{tc['name']}': {e}", tool_call_id=tc["id"]))

def nodeAgente2(state: State):
    """"""
    result = modelAgente2.invoke(
        [SystemMessage(content=_system_prompt(PROFILE3, state))]
        + state["messages"]
        
    )
    result.name = "agente2"
    return {"messages": [result]}
"
`;

exports[`Generator snapshots > MD11 > checkpointer.py 1`] = `
"from config import DB_URI
import contextlib
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver
from psycopg import AsyncConnection
from psycopg.rows import dict_row


@contextlib.asynccontextmanager
async def generate_checkpointer():
    conn = await AsyncConnection.connect(
        DB_URI,
        autocommit=True,
        row_factory=dict_row
    )
    try:
        checkpointer = AsyncPostgresSaver(conn)
        await checkpointer.setup()
        yield checkpointer
    finally:
        await conn.close()
"
`;

