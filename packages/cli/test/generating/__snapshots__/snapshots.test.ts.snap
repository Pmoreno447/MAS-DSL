from langchain_core.messages import HumanMessage
from langgraph.graph import StateGraph, START, END
from state import State, should_summarize, summary_node
from subgraph.structura1 import build_structura1
from subgraph.structura2 import build_structura2



# Construcción del grafo
builder = StateGraph(State)

# Subgrafos como nodos
structura1 = build_structura1()
structura2 = build_structura2()

builder.add_node("structura1", structura1)
builder.add_node("structura2", structura2)

builder.add_node("summary_node", summary_node)
builder.add_edge("summary_node", END)

# Edges de inicio
builder.add_edge(START, "structura1")

# Routers


# Transiciones
builder.add_edge("structura1", "structura2")
builder.add_conditional_edges(
    "structura2",
    should_summarize,
    {
        "summary_node": "summary_node",
        END: END
    }
)

# Compilar
graph = builder.compile()
"
`;

