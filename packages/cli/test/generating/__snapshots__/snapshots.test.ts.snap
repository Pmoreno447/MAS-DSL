exports[`Generator snapshots > MD14 > agents.py 1`] = `
"# agents.py
from langchain_core.messages import SystemMessage, HumanMessage, AIMessage, ToolMessage
from prompt import PROFILECOORDINADOR, PROFILEPROCESADOR
from state import State
from langchain.chat_models import init_chat_model



from pydantic import BaseModel, Field

from tools.utils import Procesador

# Salidas de los nodos
class AgenteProcesadorOutput(BaseModel):
    """Llama a esta herramienta cuando hayas terminado para entregar el resultado final."""
    resultado: str = Field(description="Resultado procesado por la herramienta Python")

# Modelos
modelAgenteProcesador = init_chat_model(model="google_genai:gemini-2.5-flash", temperature=0).bind_tools([Procesador, AgenteProcesadorOutput], tool_choice="required")

_tools_by_name = {t.name: t for t in [Procesador]}



# Nodos del grafo
async def nodeAgenteProcesador(state: State):
    """"""
    messages = (
        [SystemMessage(content=PROFILEPROCESADOR)]
        + state["messages"]
        
    )
    while True:
        response = await modelAgenteProcesador.ainvoke(messages)
        messages.append(response)
        if not response.tool_calls:
            response.name = "agenteprocesador"
            return {"messages": [response]}
        for tc in response.tool_calls:
            if tc["name"] == "AgenteProcesadorOutput":
                return {
                    "resultado": tc["args"]["resultado"]
                }
        for tc in response.tool_calls:
            tool = _tools_by_name[tc["name"]]
            try:
                result = await tool.ainvoke(tc["args"])
                messages.append(ToolMessage(content=str(result), tool_call_id=tc["id"]))
            except Exception as e:
                messages.append(ToolMessage(content=f"Error al llamar herramienta '{tc['name']}': {e}", tool_call_id=tc["id"]))
"
`;

