"# agents.py
from langchain_core.messages import SystemMessage, HumanMessage, AIMessage
from prompt import PRESPONDEYPARA, PRESPONDEYSIGUE
from state import State
from langchain.chat_models import init_chat_model

from langgraph.types import Command
from langgraph.graph import END
from typing import Literal

from pydantic import BaseModel, Field



# Salidas de los nodos
class AgenteUnoOutput(BaseModel):
    message: str = Field(description="Tu respuesta al usuario.")
    next: Literal["agenteuno", "agentedos", "agentetres", "END"] = Field(description="Próximo nodo al que delegar dentro del cluster decentralized; END para terminar.")

class AgenteDosOutput(BaseModel):
    message: str = Field(description="Tu respuesta al usuario.")
    next: Literal["agenteuno", "agentedos", "agentetres", "END"] = Field(description="Próximo nodo al que delegar dentro del cluster decentralized; END para terminar.")

class AgenteTresOutput(BaseModel):
    message: str = Field(description="Tu respuesta al usuario.")
    next: Literal["agenteuno", "agentedos", "agentetres", "END"] = Field(description="Próximo nodo al que delegar dentro del cluster decentralized; END para terminar.")

# Modelos
modelAgenteUno = init_chat_model(model="google_genai:gemini-2.5-pro", temperature=0).with_structured_output(AgenteUnoOutput)
modelAgenteDos = init_chat_model(model="google_genai:gemini-2.5-pro", temperature=0).with_structured_output(AgenteDosOutput)
modelAgenteTres = init_chat_model(model="google_genai:gemini-2.5-pro", temperature=0).with_structured_output(AgenteTresOutput)



def _system_prompt(profile: str, state) -> str:
    """Antepone el resumen acumulado de la conversación (si existe) al profile."""
    resumen = state.get("summary")
    if resumen:
        return f"{profile}\\n\\nContexto previo resumido:\\n{resumen}"
    return profile

# Nodos del grafo
def nodeAgenteUno(state: State) -> Command[Literal["agenteuno", "agentedos", "agentetres", "__end__"]]:
    """"""
    result = modelAgenteUno.invoke(
        [SystemMessage(content=_system_prompt(PRESPONDEYSIGUE, state))]
        + state["messages"]
        
    )
    goto = END if result.next == "END" else result.next
    return Command(goto=goto, update={
        "messages": [AIMessage(content=result.message, name="agenteuno")]
    })

def nodeAgenteDos(state: State) -> Command[Literal["agenteuno", "agentedos", "agentetres", "__end__"]]:
    """"""
    result = modelAgenteDos.invoke(
        [SystemMessage(content=_system_prompt(PRESPONDEYPARA, state))]
        + state["messages"]
        
    )
    goto = END if result.next == "END" else result.next
    return Command(goto=goto, update={
        "messages": [AIMessage(content=result.message, name="agentedos")]
    })

def nodeAgenteTres(state: State) -> Command[Literal["agenteuno", "agentedos", "agentetres", "__end__"]]:
    """"""
    result = modelAgenteTres.invoke(
        [SystemMessage(content=_system_prompt(PRESPONDEYPARA, state))]
        + state["messages"]
        
    )
    goto = END if result.next == "END" else result.next
    return Command(goto=goto, update={
        "messages": [AIMessage(content=result.message, name="agentetres")]
    })
"
`;

exports[`Generator snapshots > MD17 > checkpointer.py 1`] = `
"from config import DB_URI
import contextlib
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver
from psycopg import AsyncConnection
from psycopg.rows import dict_row


@contextlib.asynccontextmanager
async def generate_checkpointer():
    conn = await AsyncConnection.connect(
        DB_URI,
        autocommit=True,
        row_factory=dict_row
    )
    try:
        checkpointer = AsyncPostgresSaver(conn)
        await checkpointer.setup()
        yield checkpointer
    finally:
        await conn.close()
"
`;

