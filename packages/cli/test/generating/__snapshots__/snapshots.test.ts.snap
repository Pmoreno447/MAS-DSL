    contexto = f"""
{bloque_resumen}Conversación hasta ahora:
{_format_conversation(state["messages"])}

Estado actual del sistema:
        - resultado (Resultado procesado por la herramienta Python): {state.get("resultado", "No registrado aún")}

Decide el siguiente paso: delega al agente adecuado o responde "FINISH" si la tarea ya está resuelta.
"""
    messages = [
        SystemMessage(content=COORDINADOR_ENRUTAMIENTO + PROFILECOORDINADOR),
        HumanMessage(content=contexto),
    ]
    response = modelCoordinator.with_structured_output(Router).invoke(messages)
    goto = END if response["next"] == "FINISH" else response["next"]
    return Command(goto=goto)

def build_structura1():
    builder = StateGraph(State)

    builder.add_node("coordinator", coordinator_node)
    builder.add_node("agenteprocesador", nodeAgenteProcesador)

    builder.add_edge(START, "coordinator")
    builder.add_edge("agenteprocesador", "coordinator")

    return builder.compile()
"
`;

