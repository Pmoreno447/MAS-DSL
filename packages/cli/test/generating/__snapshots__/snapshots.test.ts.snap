"# agents.py
from langchain_core.messages import SystemMessage, HumanMessage, AIMessage, ToolMessage
from prompt import PROFILECOORDINADOR, PROFILEPROCESADOR
from state import State
from langchain.chat_models import init_chat_model



from pydantic import BaseModel, Field

from tools.utils import Procesador

# Salidas de los nodos
class AgenteProcesadorOutput(BaseModel):
    resultado: str = Field(description="Resultado procesado por la herramienta Python")

# Modelos
modelAgenteProcesador = init_chat_model(model="google_genai:gemini-2.5-flash", temperature=0).with_structured_output(AgenteProcesadorOutput)

_tools_by_name = {t.name: t for t in [Procesador]}

def _system_prompt(profile: str, state) -> str:
    """Antepone el resumen acumulado de la conversación (si existe) al profile."""
    resumen = state.get("summary")
    if resumen:
        return f"{profile}\\n\\nContexto previo resumido:\\n{resumen}"
    return profile

# Nodos del grafo
def nodeAgenteProcesador(state: State):
    """"""
    result = modelAgenteProcesador.invoke(
        [SystemMessage(content=_system_prompt(PROFILEPROCESADOR, state))]
        + state["messages"]
        
    )
    return {
        "resultado": result.resultado
    }
"
`;

