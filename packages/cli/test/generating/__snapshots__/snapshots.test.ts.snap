exports[`Generator snapshots > MD01 > graph.py 1`] = `
"import os
from config import ANTHROPIC_API_KEY
os.environ["ANTHROPIC_API_KEY"] = ANTHROPIC_API_KEY
from langchain_core.messages import HumanMessage
from langgraph.graph import StateGraph, START, END
from state import State
from subgraph.structura1 import build_structura1
from subgraph.structura2 import build_structura2
from subgraph.structura3 import build_structura3



# Construcción del grafo
builder = StateGraph(State)

# Subgrafos como nodos
structura1 = build_structura1()
structura2 = build_structura2()
structura3 = build_structura3()

builder.add_node("structura1", structura1)
builder.add_node("structura2", structura2)
builder.add_node("structura3", structura3)



# Edges de inicio
builder.add_edge(START, "structura1")

# Routers
def route_structura1(state: State) -> str:
    if state["herramientas"] == False:
        return "structura2"
    return "structura3"

# Transiciones
builder.add_conditional_edges(
    "structura1",
    route_structura1,
    {
        "structura2": "structura2",
        "structura3": "structura3"
    }
)
builder.add_edge("structura2", END)
builder.add_edge("structura3", END)

# Compilar
graph = builder.compile()
"
`;

