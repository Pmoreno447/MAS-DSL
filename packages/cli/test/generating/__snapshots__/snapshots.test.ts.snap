exports[`Generator snapshots > MD09 > agents.py 1`] = `
"# agents.py
from langchain_core.messages import SystemMessage, HumanMessage, AIMessage
from prompt import PRESPONDEYPARA, PRESPONDEYSIGUE
from state import State
from langchain.chat_models import init_chat_model

from langgraph.types import Command
from langgraph.graph import END
from typing import Literal

from pydantic import BaseModel, Field



# Salidas de los nodos
class AgenteUnoOutput(BaseModel):
    message: str = Field(description="Tu respuesta al usuario.")
    next: Literal["agenteuno", "agentedos", "agentetres", "END"] = Field(description="Próximo nodo al que delegar dentro del cluster decentralized; END para terminar.")

class AgenteDosOutput(BaseModel):
    message: str = Field(description="Tu respuesta al usuario.")
    next: Literal["agenteuno", "agentedos", "agentetres", "END"] = Field(description="Próximo nodo al que delegar dentro del cluster decentralized; END para terminar.")

class AgenteTresOutput(BaseModel):
    message: str = Field(description="Tu respuesta al usuario.")
    next: Literal["agenteuno", "agentedos", "agentetres", "END"] = Field(description="Próximo nodo al que delegar dentro del cluster decentralized; END para terminar.")

# Modelos
modelAgenteUno = init_chat_model(model="openai:gpt-4o", temperature=0).with_structured_output(AgenteUnoOutput)
modelAgenteDos = init_chat_model(model="openai:gpt-4o", temperature=0).with_structured_output(AgenteDosOutput)
modelAgenteTres = init_chat_model(model="openai:gpt-4o", temperature=0).with_structured_output(AgenteTresOutput)





# Nodos del grafo
def nodeAgenteUno(state: State) -> Command[Literal["agenteuno", "agentedos", "agentetres", "__end__"]]:
    """"""
    result = modelAgenteUno.invoke(
        [SystemMessage(content=PRESPONDEYSIGUE)]
        + state["messages"]
        
    )
    goto = END if result.next == "END" else result.next
    return Command(goto=goto, update={
        "messages": [AIMessage(content=result.message, name="agenteuno")]
    })

def nodeAgenteDos(state: State) -> Command[Literal["agenteuno", "agentedos", "agentetres", "__end__"]]:
    """"""
    result = modelAgenteDos.invoke(
        [SystemMessage(content=PRESPONDEYPARA)]
        + state["messages"]
        
    )
    goto = END if result.next == "END" else result.next
    return Command(goto=goto, update={
        "messages": [AIMessage(content=result.message, name="agentedos")]
    })

def nodeAgenteTres(state: State) -> Command[Literal["agenteuno", "agentedos", "agentetres", "__end__"]]:
    """"""
    result = modelAgenteTres.invoke(
        [SystemMessage(content=PRESPONDEYPARA)]
        + state["messages"]
        
    )
    goto = END if result.next == "END" else result.next
    return Command(goto=goto, update={
        "messages": [AIMessage(content=result.message, name="agentetres")]
    })
"
`;

