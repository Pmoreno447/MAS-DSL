from langchain_core.messages import SystemMessage, HumanMessage, AIMessage, ToolMessage
from prompt import PROFILE1, PROFILE2, PROFILE3
from state import State
from langchain.chat_models import init_chat_model


from config import OLLAMA_BASE_URL
from pydantic import BaseModel, Field

from tools.calculator import Suma
from tools.calculator import Resta

# Salidas de los nodos
class AgenteSumaOutput(BaseModel):
    """Llama a esta herramienta cuando hayas terminado para entregar el resultado final."""
    result: int = Field(description="Resultado de la operación.")

class AgenteRestaOutput(BaseModel):
    """Llama a esta herramienta cuando hayas terminado para entregar el resultado final."""
    result: int = Field(description="Resultado de la operación.")

# Modelos
modelAgenteSuma = init_chat_model(model="ollama:qwen2.5:7b", temperature=0, base_url=OLLAMA_BASE_URL).bind_tools([Suma, AgenteSumaOutput], tool_choice="required")
modelAgenteResta = init_chat_model(model="ollama:qwen2.5:7b", temperature=0, base_url=OLLAMA_BASE_URL).bind_tools([Resta, AgenteRestaOutput], tool_choice="required")
modelEscritor = init_chat_model(model="ollama:qwen2.5:7b", temperature=1, base_url=OLLAMA_BASE_URL)

_tools_by_name = {t.name: t for t in [Suma, Resta]}



# Nodos del grafo
async def nodeAgenteSuma(state: State):
    """"""
    messages = (
        [SystemMessage(content=PROFILE2)]
        + state["messages"]
        
    )
    while True:
        response = await modelAgenteSuma.ainvoke(messages)
        messages.append(response)
        if not response.tool_calls:
            response.name = "agentesuma"
            return {"messages": [response]}
        for tc in response.tool_calls:
            if tc["name"] == "AgenteSumaOutput":
                return {
                    "result": tc["args"]["result"]
                }
        for tc in response.tool_calls:
            tool = _tools_by_name[tc["name"]]
            try:
                result = await tool.ainvoke(tc["args"])
                messages.append(ToolMessage(content=str(result), tool_call_id=tc["id"]))
            except Exception as e:
                messages.append(ToolMessage(content=f"Error al llamar herramienta '{tc['name']}': {e}", tool_call_id=tc["id"]))

async def nodeAgenteResta(state: State):
    """"""
    messages = (
        [SystemMessage(content=PROFILE2)]
        + state["messages"]
        
    )
    while True:
        response = await modelAgenteResta.ainvoke(messages)
        messages.append(response)
        if not response.tool_calls:
            response.name = "agenteresta"
            return {"messages": [response]}
        for tc in response.tool_calls:
            if tc["name"] == "AgenteRestaOutput":
                return {
                    "result": tc["args"]["result"]
                }
        for tc in response.tool_calls:
            tool = _tools_by_name[tc["name"]]
            try:
                result = await tool.ainvoke(tc["args"])
                messages.append(ToolMessage(content=str(result), tool_call_id=tc["id"]))
            except Exception as e:
                messages.append(ToolMessage(content=f"Error al llamar herramienta '{tc['name']}': {e}", tool_call_id=tc["id"]))

def nodeEscritor(state: State):
    """"""
    result = modelEscritor.invoke(
        [SystemMessage(content=PROFILE3)]
        + state["messages"]
        + [HumanMessage(content=f"""
            result: {state.get("result", "No registrado aún")}
        """)]
    )
    return {"messages": [result]}
"
`;

