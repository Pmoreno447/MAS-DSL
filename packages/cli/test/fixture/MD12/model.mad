/* En este modelo las dimensiones testeadas son:
- Postgre.
- OpenAI
- Sin Herramientas.
- Mix
*/
{
    context Template {
        maxMessages 3
        persistence Postgre
    }

    profile profile1 description
    "
Sé educado con el usuario. Contesta de forma excesivamente larga.
    "
    // agent, coordinator or summarizer
    agent Agente1 {
        provider openai
        model "gpt-4o"
        profile profile1
        temperature 0.2
    }

    summarizer Resumidor {
        provider openai
        model "gpt-4o"
        tokenTrigger 800
    }

    // Layered, shared_message_pool, centralized or decentralized
    layered structura1 {
        layer Agente1
    }

    from START to structura1
    //from structura1 to structura2 when result equal False
    from structura1 to END
}
