{
    context Test05 {
        persistence inMemorySave
    }

    profile asistente description
    "
Asistente conversacional amigable
    "

    profile resumen description
    "
    "

    agent chatBot {
        provider openai
        model "gpt-4o"
        profile asistente
        description "Chatbot"

    }

    summarizer Test {
        provider openai
        model "gpt-4o"
        profile resumen
        tokenTrigger 150
    }

    layered Grafo {
        layer chat level 1 agent chatBot
    }

    from START to Grafo
    from Grafo to END
}