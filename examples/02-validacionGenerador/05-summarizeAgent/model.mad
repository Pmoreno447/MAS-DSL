{
    environment Test05 {
        summarize {
            maxToken 150
            provider openai
            model "gpt-4o"
        }
        persistence inMemorySave
    }

    profile asistente description
    "
Asistente conversacional amigable
    "

    agent chatBot {
        provider openai
        model "gpt-4o"
        profile asistente
        description "Chatbot"

    }

    layered Grafo {
        layer chat level 1 agent chatBot
    }

    from START to Grafo
    from Grafo to END
}