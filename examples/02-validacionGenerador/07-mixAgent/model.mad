{
    context Test07 {
        maxMessages 4
        persistence inMemorySave
    }

    profile asistente description
    "
Asistente conversacional amigable
    "

    profile resumen description
    "
    "

    agent chatBot {
        provider openai
        model "gpt-4o"
        profile asistente
        description "Chatbot"

    }

    summarizer test {
        provider openai
        model "gpt-4o"
        tokenTrigger 200
    }

    layered Grafo {
        layer chatBot
    }

    from START to Grafo
    from Grafo to END
}