    
{
    context bdTester {
        persistence Postgre
    }

    profile agente1 description
    "
    Escribe una función en python con lo que te pidan. 
    "

    profile agente2 description
    "
    Analiza el código y detecta si algo está mal, si es el caso corrigelo.
    "

    agent Agent1 {
        provider openai
        model "gpt-4o-mini"
        profile agente1
        statusMessage " 🖥️ programando funcion..."
    }

    agent Agent2 {
        provider openai
        model "gpt-4o-mini"
        profile agente2
        statusMessage " ✍🏼 revisando funcion..."
    }

    layered example {
        layer Agent1 next Agent2
        layer Agent2
    }

    from START to example
    from example to END
}