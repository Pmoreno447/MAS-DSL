{
    context Template {
        attribute info type string description "example of information exchange between agents"
        attribute result type boolean description "example of attribute"
        attribute entero type int description "prueba"

        //maxMessages 3 //trim
        persistence inMemorySave // MongoDB | Postgre
    }
    
    profile profile1 description
    "
PROMPT 1
    "
    
    profile profile2 description
    "
PROMPT 2
    "  

    // Tools:
    
    pythonTool exampleTool modulePath "utils"
    mcpServer Tavily {
        url "https://mcp.tavily.com/mcp/?tavilyApiKey={key}"
        transport "streamable_http"
        apiKeyName "TAVILY_API_KEY"
        tools "tavily_search", "tavily_extract"
    }
    

    // agent, coordinator or summarizer
    agent Agente1 {
        provider openai
        model "gpt-4o"
        profile profile1
        temperature 0.0

        stateUpdate info
    }

    agent Agente2 {
        provider openai
        model "gpt-4o"
        profile profile2

        //description "This is an ai agent"
        stateContext info
        stateUpdate result

        //statusMessage "Im working in the result"
        //maxToken 3000
        //timeOut 100
        //maxRetries 2
        //tools 
    }

    coordinator Coordinador {
        provider ollama
        model "llama3.1"
        profile profile1
    }

    // Layered, Centralized or Decentralized
    layered structura1 {
        layer Agente1 next Agente2
        layer Agente2
    }

    decentralized as {
        agents Agente1, Agente2
    }

    centralized as2 {
        coordinator Coordinador
        agents Agente1, Agente2
    }

    from START to structura1
    from structura1 to as
    from as to as2
    //from structura1 to as when result equal False
    from structura1 to as2 when info equal "hola"
    //from structura1 to END when entero equal 21
    from as2 to END
}